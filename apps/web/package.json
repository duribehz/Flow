{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "oxlint && oxfmt --check .",
    "check:write": "oxlint --fix && oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
