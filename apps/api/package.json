{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/shared/infrastructure/database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.72.0",
    "typescript": "^7.0.2"
  }
}
